{
  "name": "qoe-web-player",
  "version": "1.0.0",
  "description": "Web video player with QoE metrics collection",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:headed": "playwright test --project=chromium --headed",
    "e2e:debug": "playwright test --project=chromium --debug",
    "e2e:ui": "playwright test --ui",
    "e2e:throttle": "playwright test --project=chromium-throttle --workers=1",
    "e2e:all": "playwright test --project=chromium && playwright test --project=chromium-throttle --workers=1",
    "e2e:docker": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --project=chromium",
    "e2e:docker:headed": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --project=chromium --headed",
    "e2e:docker:throttle": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --project=chromium-throttle --workers=1",
    "e2e:docker:all": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:3000 npm run e2e:docker && cross-env PLAYWRIGHT_BASE_URL=http://localhost:3000 npm run e2e:docker:throttle",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "e2e:allure": "npm run e2e:docker && npm run allure:generate",
    "e2e:docker:allure": "cross-env PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --project=chromium && npm run allure:generate",
    "report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "hls.js": "^1.4.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "allure-playwright": "^3.7.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
